{
  // Harness modules (../harnesses), the harness library, the eval adapter
  // and harness tooling. Used by `npm run typecheck`, tsx and vitest.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.harness.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@harness": ["./src/harness/index.ts"],
      "@harness/*": ["./src/harness/*"],
      "@app/*": ["./src/*"],
      "@harness-tools/*": ["./harness-tools/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "vitest": ["./node_modules/vitest"]
    }
  },
  "include": ["src/harness", "harness-tools", "../harnesses", "../eval/adapters/*.ts"]
}
